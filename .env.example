# ---- Core ----
APP_ENV=local                       # local | staging | production | test
PORT=4000
PLATFORM_DOMAIN=yourplatform.ng     # root domain; school hosts are {slug}.PLATFORM_DOMAIN
WEB_ORIGIN=http://localhost:3000    # where the Next.js app runs (used in links sent by SMS and email)
LOG_LEVEL=info

# ---- Data ----
MONGODB_URI=mongodb://127.0.0.1:27017/viriah?replicaSet=rs0
REDIS_URL=                          # leave empty to use the in-process queue and in-memory rate limits

# ---- Secrets (generate long random strings) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_SUPPORT_SECRET=change-me-support-secret-at-least-32-chars
COOKIE_SECRET=change-me-cookie-secret-at-least-32-chars
REVALIDATE_SECRET=change-me-revalidate-secret

# ---- Payments (Paystack). Leave the secret empty to use the built-in fake provider ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- SMS (Termii). Leave empty to print messages to the console ----
TERMII_API_KEY=
TERMII_SENDER_ID=

# ---- Email. Leave empty to print messages to the console ----
EMAIL_API_KEY=
EMAIL_FROM=no-reply@yourplatform.ng

# ---- Files (Cloudinary). Leave empty to store files on local disk ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Monitoring ----
SENTRY_DSN=

# ---- Seed ----
SUPER_ADMIN_PHONE=+2349000000001
SUPER_ADMIN_EMAIL=admin@yourplatform.ng
SUPER_ADMIN_PASSWORD=ChangeMe!12345
