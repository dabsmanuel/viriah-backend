{
  "name": "viriah-api",
  "version": "1.0.0",
  "private": true,
  "description": "Viriah school academic management platform: API and background worker",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:stack": "tsx src/dev/stack.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:platform": "tsx src/seed/index.ts platform",
    "seed:demo": "tsx src/seed/index.ts demo",
    "migrate": "tsx src/migrations/run.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "nanoid": "^3.3.20",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
